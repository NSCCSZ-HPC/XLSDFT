# LX2 build configuration.

override CC = mpicxx

CFLAGS = -O3 -std=c++17
CPPFLAGS = -Iinclude/
BINBASE = ./a.out
LDFLAGS =
LDLIBS = -lm

CPPFLAGS += -Wall -Wextra -Wpedantic
CPPFLAGS += -Werror -Wno-array-bounds
CPPFLAGS += -Wno-c99-extensions

# LVTX backend.
USE_LVTX_BACKEND = 1
LVTX_BLAS_ROOT ?= /home/share/shenchao_common/lvtx_blas

CPPFLAGS += -m64 -march=armv9-a+sve+sve2+sme+sme2+sme-f64f64+sme-i16i64+sme-fa64 -Wno-undefined-arm-streaming
CPPFLAGS += -DUSE_LAPACK -DXLSDFT_BACKEND_FREE -DCHEFSI_SWPF4
LDLIBS += -rtlib=compiler-rt -lunwind

# OpenMP.
USE_OPENMP = 1
ifeq ($(USE_OPENMP), 1)
	CFLAGS += -fopenmp
	CPPFLAGS += -DUSE_OPENMP
endif

# FFTW support for the DST preconditioner.
USE_FFTW = 1
ifeq ($(USE_FFTW), 1)
	CPPFLAGS += -DUSE_FFTW
	ifdef FFTWROOT
		CPPFLAGS += -I$(FFTWROOT)/include
		LDFLAGS += -L$(FFTWROOT)/lib
	endif
	LDLIBS += -lfftw3 -lfftw3f
endif

# Half precision and runtime diagnostics used by this build.
FP16_FLAG = 1
LOW_MEMORY = 1
ENABLE_TIMER = 1

ifeq ($(FP16_FLAG), 1)
	CPPFLAGS += -DFP16_FLAG
endif
ifeq ($(LOW_MEMORY), 1)
	CPPFLAGS += -DLOW_MEMORY
endif
ifeq ($(ENABLE_TIMER), 1)
	CPPFLAGS += -DENABLE_TIMER
endif

# HBM allocation support.
USE_HBM = 1
USE_HUGEPAGE_HBM = 0
HBMROOT ?= /home/share/shenchao_common/memory

ifeq ($(USE_HBM), 1)
	LDFLAGS += -L$(HBMROOT)/lib -Wl,-rpath,$(HBMROOT)/lib
	ifeq ($(USE_HUGEPAGE_HBM), 1)
		CPPFLAGS += -I$(HBMROOT)/include -DUSE_HUGEPAGE_HBM -DUSE_HBM
	else
		CPPFLAGS += -I$(HBMROOT)/include -DUSE_HBM
	endif
	LDLIBS += -lmemkind -lhwloc -lnuma
endif

# SStructMG Poisson solver.
USE_SSTRUCTMG = 1
SOFT_HOME ?= /home/share/eapp_common/jzp/local-0825
JSON_HOME ?= $(SOFT_HOME)/jsoncpp/debug
SSTRUCTMG_HOME ?= $(SOFT_HOME)/SStructMG-codex-HPCK25.2.1-dof1-US-struct-noFP16-noFsan-CacheBlock-3SComm

ifeq ($(USE_SSTRUCTMG), 1)
	JSON_INC = $(JSON_HOME)/include
	JSON_LIB = -L$(JSON_HOME)/lib64 -ljsoncpp -Wl,-rpath=$(JSON_HOME)/lib64
	SSTRUCTMG_LIB = $(SSTRUCTMG_HOME)/lib
	SSTRUCTMG_INC = $(SSTRUCTMG_HOME)/include
	L_SSTRUCTMG = -L$(SSTRUCTMG_LIB) -lSstructmg -Wl,-rpath=$(SSTRUCTMG_LIB) $(JSON_LIB)

	CPPFLAGS += -I$(JSON_INC)
	CPPFLAGS += -I$(SSTRUCTMG_INC) -DUSE_SSTRUCTMG
	CPPFLAGS += -DMG_FLOAT32 -DUSE_MG_3d7 -DSIMD_LEN=512
	LDFLAGS += $(L_SSTRUCTMG)
	LDLIBS += -lstdc++ -ldl
endif

# OpenMP team size for optimized kernels.
NT ?= 36
CPPFLAGS += -Dstencil_nthread=$(NT) -Dnloc_nthread=$(NT) \
            -Dprojection_nthread=$(NT) -Ddia_nthread=$(NT) \
            -Drotation_nthread=$(NT) -DNT=$(NT)

ifeq ($(USE_LVTX_BACKEND), 1)
	BACKEND_OBJSC = backend_free.o lvtx_backend.o
endif
